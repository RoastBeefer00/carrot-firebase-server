package views

import "github.com/RoastBeefer00/carrot-firebase-server/services"

// GroceryList combines the ingredients of every meal on the grocery list. Which
// items are checked off is kept in the browser, so it survives a refresh.
templ GroceryList(items []services.GroceryItem, meals int) {
	<div class="flex flex-col gap-3" x-data="groceryList">
		<div class="flex items-start justify-between gap-3">
			<div>
				<h2 class="text-xl font-semibold text-text">Grocery list</h2>
				<p class="text-sm text-subtext0">
					{ plural(len(items), "item", "items") } from { plural(meals, "meal", "meals") }
				</p>
			</div>
			<div class="seg" role="group" aria-label="Batch size">
				<button type="button" x-on:click="doubled = false" x-bind:class="!doubled && 'is-on'" class="is-on">2×</button>
				<button type="button" x-on:click="doubled = true" x-bind:class="doubled && 'is-on'">4×</button>
			</div>
		</div>
		if len(items) == 0 {
			<div class="empty">
				<b>Nothing to buy</b>
				Turn on the grocery toggle for a meal to add its ingredients.
			</div>
		} else {
			<ul>
				for _, item := range items {
					<li>
						<label class="flex items-start gap-3 py-2.5 border-b border-surface0 cursor-pointer text-text has-checked:text-overlay0 has-checked:line-through">
							<input
								type="checkbox"
								data-key={ item.Format(1) }
								x-bind:checked="isChecked($el.dataset.key)"
								x-on:change="toggle($el.dataset.key)"
								class="mt-1 size-[18px] accent-lavender shrink-0"
							/>
							<span x-show="!doubled">{ item.Format(1) }</span>
							<span x-show="doubled" x-cloak>{ item.Format(2) }</span>
						</label>
					</li>
				}
			</ul>
			<button type="button" x-show="checked.length" x-cloak x-on:click="clear()" class="self-start text-sm text-subtext0 underline underline-offset-4 hover:text-text">Uncheck everything</button>
		}
	</div>
}

templ GroceriesPage(s ShellData, items []services.GroceryItem, meals int) {
	@Shell(s) {
		@viewCtx("groceries", "", "")
		<main class="mx-auto w-full max-w-xl px-4 pt-5 pb-10">
			@GroceryList(items, meals)
		</main>
	}
}

// GroceryDrawer shows the grocery list over the page on desktop.
templ GroceryDrawer(items []services.GroceryItem, meals int) {
	<div x-data x-on:keydown.escape.window="$root.remove()">
		<button type="button" aria-label="Close grocery list" class="fixed inset-0 z-50 bg-crust/60" x-on:click="$root.remove()"></button>
		<aside role="dialog" aria-label="Grocery list" class="fixed z-50 inset-y-0 right-0 w-full max-w-[420px] flex flex-col bg-base border-l border-surface1 shadow-2xl">
			<div class="flex justify-end p-2">
				<button type="button" aria-label="Close" x-on:click="$root.remove()" class="icon-btn">
					@icon("close", 22)
				</button>
			</div>
			<div class="flex-1 overflow-y-auto px-5 pb-6">
				@GroceryList(items, meals)
			</div>
		</aside>
	</div>
}
