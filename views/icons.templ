// icon draws a 24×24 icon by name. Appending "Off" draws it with a slash, as in
// "cartOff" for a recipe left off the grocery list.
templ icon(name string, size int) {
	<svg xmlns="http://www.w3.org/2000/svg" width={ strconv.Itoa(size) } height={ strconv.Itoa(size) } viewBox="0 0 24 24" aria-hidden="true" class="shrink-0">
		<path fill="currentColor" d={ iconPaths[strings.TrimSuffix(name, "Off")] }></path>
		if strings.HasSuffix(name, "Off") {
			<path stroke="currentColor" stroke-width="2" stroke-linecap="round" d="M3 3l18 18"></path>
		}
	</svg>
}
