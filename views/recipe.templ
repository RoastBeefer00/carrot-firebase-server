package views

import (
	"strconv"

	"github.com/RoastBeefer00/carrot-firebase-server/services"
)

// RecipesPage lists a week's meals by date (or the user's favorites) next to
// the selected recipe. On a phone the list and the recipe are separate screens.
templ RecipesPage(s ShellData, d RecipesData) {
	@Shell(s) {
		@viewCtx("recipes", d.selectedID(), d.List, d.Week.Param())
		<div class={ "reader", templ.KV("show-detail", d.Detail) }>
			<aside class="reader-list">
				<div class="flex flex-col gap-2 p-3">
					<div class="seg seg-full" role="group" aria-label="Show">
						@listTab("week", "Meals", d.List == "week", d.Week)
						@listTab("fav", "Favorites · "+strconv.Itoa(len(d.Favorites)), d.List == "fav", d.Week)
					</div>
					if d.List == "week" {
						// A block wrapper keeps SearchBox's flex size from becoming a height here.
						<div>
							@SearchBox()
						</div>
						<div class="flex items-center justify-between gap-2 pl-1">
							<div class="min-w-0">
								<p class="text-text font-semibold leading-tight">{ d.Week.Label() }</p>
								<p class="text-xs text-subtext0 tabular-nums">{ d.Week.Range() }</p>
							</div>
							@weekNav("recipes", "week", "", d.Week)
						</div>
					}
				</div>
				<div class="reader-scroll" data-keep-scroll="reader-list">
					if d.List == "week" {
						@mealList(d)
					} else {
						@favoriteList(d)
					}
				</div>
				if d.List == "week" && len(d.Meals) > 0 {
					<div class="px-4 py-2.5 border-t border-surface0">
						@clearWeek()
					</div>
				}
			</aside>
			<main class="reader-pane">
				if d.Selected != nil {
					@reader(*d.Selected, d.List, d.Week)
				} else if d.List == "fav" {
					<div class="empty">
						<b>No favorites yet</b>
						Tap the heart on a recipe to save it here.
					</div>
				} else {
					<div class="empty">
						<b>Nothing planned yet</b>
						Search for a recipe or add a random one from the Plan page.
					</div>
				}
			</main>
		</div>
	}
}

templ listTab(list, label string, active bool, w Week) {
	<button
		type="button"
		hx-get="/api/view"
		hx-vals={ vals("view", "recipes", "list", list, "sel", "", "week", w.Param()) }
		hx-push-url={ RecipesURL(list, "", w.Param()) }
		class={ templ.KV("is-on", active) }
	>{ label }</button>
}

// mealList groups the shown week's meals by date, then the unplanned ones,
// then any planned for other weeks. Every date is listed so meals can be
// dragged onto it.
templ mealList(d RecipesData) {
	if len(d.Meals) == 0 {
		<div class="empty m-2">No meals planned yet.</div>
	} else {
		for _, day := range dayChoices(d.Week) {
			<div class="reader-day" data-drop={ day }>
				<h2 class={ "label px-3 mb-1", templ.KV("text-lavender!", day != "" && d.Week.Today.Format(services.DateLayout) == day) }>
					if day == "" {
						Not planned
					} else {
						{ DayLong(day) }
					}
				</h2>
				<ul data-items>
					for _, r := range recipesOn(d.Meals, day) {
						<li>
							@listItem(r, d, true)
						</li>
					}
				</ul>
				<p class={ "reader-empty", templ.KV("hidden", len(recipesOn(d.Meals, day)) > 0) } data-empty>
					if day == "" {
						Every meal has a day
					} else {
						Nothing planned
					}
				</p>
			</div>
		}
		if others := d.elsewhere(); len(others) > 0 {
			<div class="reader-day">
				<h2 class="label px-3 mb-1">Other weeks</h2>
				<ul>
					for _, r := range others {
						<li>
							@listItem(r, d, true)
						</li>
					}
				</ul>
			</div>
		}
	}
}

templ favoriteList(d RecipesData) {
	if len(d.Favorites) == 0 {
		<div class="empty m-2">Tap the heart on a recipe to save it here.</div>
	} else {
		<ul class="px-0">
			for _, r := range d.Favorites {
				<li>
					@listItem(r, d, false)
				</li>
			}
		</ul>
	}
}

// listItem selects a recipe. Planned items can also be dragged to another day.
templ listItem(r services.Recipe, d RecipesData, draggable bool) {
	<a
		href={ templ.SafeURL(RecipesURL(d.List, r.Id, d.Week.Param())) }
		hx-get="/api/view"
		hx-vals={ vals("view", "recipes", "list", d.List, "sel", r.Id, "week", d.Week.Param()) }
		hx-push-url={ RecipesURL(d.List, r.Id, d.Week.Param()) }
		data-scroll-top
		if draggable {
			data-drag={ r.Id }
		}
		class={ "reader-item",
			templ.KV("is-on", d.Selected != nil && d.Selected.Id == r.Id),
			templ.KV("is-off", draggable && r.SkipGroceries) }
	>
		if draggable {
			<span class="grip" data-grip title="Drag to another day">
				@icon("grip", 18)
			</span>
		}
		<span class="flex-1 min-w-0 flex flex-col">
			<span class="reader-item-name">{ r.Name }</span>
			<span class="flex items-center gap-2 text-xs text-subtext0">
				if r.Day != "" && (!draggable || !d.Week.Contains(r.Day)) {
					<span class="text-lavender">{ dayShort(r.Day) }</span>
				} else if !draggable && r.InWeek {
					<span class="text-lavender">Not planned</span>
				}
				{ r.Time }
				if r.Favorite {
					<span class="text-green">
						@icon("heartF", 13)
					</span>
				}
				if draggable && r.SkipGroceries {
					<span>not on list</span>
				}
			</span>
		</span>
		<span class="text-overlay0 md:hidden">
			@icon("right", 20)
		</span>
	</a>
}

templ reader(r services.Recipe, list string, w Week) {
	<article class="reader-article">
		<button
			type="button"
			hx-get="/api/view"
			hx-vals={ vals("view", "recipes", "list", list, "sel", "", "week", w.Param()) }
			hx-push-url={ RecipesURL(list, "", w.Param()) }
			class="md:hidden self-start -ml-2 inline-flex items-center gap-2 h-9 px-2 rounded-lg text-subtext0 hover:bg-surface0 font-semibold text-sm"
		>
			@icon("back", 18)
			if list == "fav" {
				Favorites
			} else {
				Meals
			}
		</button>
		<div>
			<p class="label text-lavender!">
				if r.InWeek {
					{ dayLabel(r) }
				} else {
					Favorite · not planned
				}
			</p>
			<h1 class="mt-1 text-3xl md:text-4xl font-semibold leading-tight tracking-tight text-text text-balance">{ r.Name }</h1>
			<p class="mt-1 text-subtext0">
				{ r.Time } · { plural(len(r.Ingredients), "ingredient", "ingredients") } · { plural(len(r.Steps), "step", "steps") }
			</p>
		</div>
		if r.InWeek {
			<div class="md:max-w-xs">
				@MakeRecipe(r)
			</div>
			<div class="flex flex-wrap items-center gap-2">
				<button
					type="button"
					hx-post={ "/api/recipes/groceries/" + r.Id }
					aria-pressed={ strconv.FormatBool(!r.SkipGroceries) }
					class={ "pill", templ.KV("is-on", !r.SkipGroceries) }
				>
					if r.SkipGroceries {
						@icon("cartOff", 18)
						Not on grocery list
					} else {
						@icon("cart", 18)
						On grocery list
					}
				</button>
				@favoriteLabeled(r)
				<button type="button" hx-post={ "/api/recipes/replace/" + r.Id } class="ghost-btn">
					@icon("swap", 18)
					Swap
				</button>
				<button type="button" hx-delete={ "/api/recipes/" + r.Id } class="ghost-btn text-red!">
					@icon("trash", 18)
					Remove
				</button>
			</div>
			<div class="flex flex-col gap-2">
				<div class="flex items-center gap-2">
					<span class="label">Cook on · { w.Label() }</span>
					@weekNav("recipes", list, r.Id, w)
				</div>
				<div class="flex flex-wrap gap-1.5">
					for _, day := range dayChoices(w) {
						<button
							type="button"
							hx-post={ "/api/plan/day/" + r.Id }
							hx-vals={ vals("day", day) }
							aria-pressed={ strconv.FormatBool(r.Day == day) }
							class={ "day-chip", templ.KV("is-on", r.Day == day) }
						>
							if day == "" {
								Not planned
							} else {
								{ dayChip(day) }
							}
						</button>
					}
				</div>
			</div>
		} else {
			<div class="flex flex-wrap items-center gap-2">
				<button type="button" hx-post={ "/api/recipes/week/" + r.Id } class="inline-flex items-center gap-2 h-11 px-4 rounded-xl bg-lavender text-crust font-semibold hover:opacity-90">
					@icon("plus", 20)
					Add to this week
				</button>
				@favoriteLabeled(r)
			</div>
		}
		<div class="reader-cols">
			<section class="rounded-2xl bg-surface0 p-4">
				<h2 class="label text-green!">Ingredients</h2>
				<ul class="mt-2 flex flex-col gap-1.5">
					for _, ingredient := range r.Ingredients {
						<li class="flex gap-2 text-text">
							<span class="text-green">•</span>
							{ services.FormatIngredient(ingredient) }
						</li>
					}
				</ul>
			</section>
			<section>
				<h2 class="label text-blue!">Steps</h2>
				<ol class="mt-2 flex flex-col gap-3 max-w-[68ch]">
					for i, step := range r.Steps {
						<li class="flex gap-2.5 text-text text-base">
							<span class="text-blue font-semibold shrink-0 w-6 text-right tabular-nums">{ strconv.Itoa(i+1) }.</span>
							<span>{ step }</span>
						</li>
					}
				</ol>
			</section>
		</div>
	</article>
}

templ favoriteLabeled(r services.Recipe) {
	<button type="button" hx-post={ "/api/recipes/favorites/" + r.Id } aria-pressed={ strconv.FormatBool(r.Favorite) } class="ghost-btn text-green!">
		if r.Favorite {
			@icon("heartF", 18)
			Favorited
		} else {
			@icon("heart", 18)
			Favorite
		}
	</button>
}
