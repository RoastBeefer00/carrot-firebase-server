package views

import (
	"strconv"

	"github.com/RoastBeefer00/carrot-firebase-server/services"
)

templ FavoriteButton(favorite bool, id string) {
	<button
		hx-post={ "/api/recipes/favorites/" + id }
		hx-swap="none"
		type="button"
		x-data
		x-on:click="$el.classList.toggle('is-favorited')"
		x-on:htmx:response-error="$el.classList.toggle('is-favorited')"
		x-on:htmx:send-error="$el.classList.toggle('is-favorited')"
		class={ "favorite-btn inline-flex items-center justify-center w-10 h-10 rounded-xl text-green hover:bg-green/15 active:scale-[0.95] transition-all hover:cursor-pointer", templ.KV("is-favorited", favorite) }
	>
		<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" class="heart-outline">
			<path fill="currentColor" d="M12 20.325q-.35 0-.712-.125t-.638-.4l-1.725-1.575q-2.65-2.425-4.788-4.812T2 8.15Q2 5.8 3.575 4.225T7.5 2.65q1.325 0 2.5.562t2 1.538q.825-.975 2-1.537t2.5-.563q2.35 0 3.925 1.575T22 8.15q0 2.875-2.125 5.275T15.05 18.25l-1.7 1.55q-.275.275-.637.4t-.713.125M11.05 6.75q-.725-1.025-1.55-1.563t-2-.537q-1.5 0-2.5 1t-1 2.5q0 1.3.925 2.763t2.213 2.837q1.287 1.375 2.65 2.575T12 18.3q.85-.775 2.213-1.975t2.65-2.575q1.287-1.375 2.212-2.837T20 8.15q0-1.5-1-2.5t-2.5-1q-1.175 0-2 .538T12.95 6.75q-.175.25-.425.375T12 7.25q-.275 0-.525-.125t-.425-.375m.95 4.725"></path>
		</svg>
		<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" class="heart-filled">
			<path fill="currentColor" d="M12 20.325q-.35 0-.712-.125t-.638-.4l-1.725-1.575q-2.65-2.425-4.788-4.812T2 8.15Q2 5.8 3.575 4.225T7.5 2.65q1.325 0 2.5.562t2 1.538q.825-.975 2-1.537t2.5-.563q2.35 0 3.925 1.575T22 8.15q0 2.875-2.125 5.275T15.05 18.25l-1.7 1.55q-.275.275-.637.4t-.713.125"></path>
		</svg>
	</button>
}

templ Recipes(recipes []services.Recipe, oob bool) {
	<div class="flex flex-col gap-2.5" id="recipes">
		for _, recipe := range recipes {
			@Recipe(recipe, oob)
		}
	</div>
}

templ Recipe(recipe services.Recipe, oob bool) {
	@recipeCard(recipe, oob) {
		<div class="flex items-center gap-1 shrink-0">
			@GroceryToggle(recipe)
			@FavoriteButton(recipe.Favorite, recipe.Id)
			<button
				hx-post={ "/api/recipes/replace/" + recipe.Id }
				hx-target={ "#recipe-" + recipe.Id }
				hx-swap="outerHTML"
				type="button"
				class="inline-flex items-center justify-center w-10 h-10 rounded-xl text-sky hover:bg-sky/15 active:scale-[0.95] transition-all hover:cursor-pointer"
			>
				<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 20 20" class="button-icon">
					<g fill="currentColor">
						<path d="M13.937 4.211a1 1 0 0 1-1.126 1.653A5 5 0 1 0 15 10a1 1 0 1 1 2 0a7 7 0 1 1-3.063-5.789"></path>
						<path d="M13.539 12.506a1 1 0 1 1-1.078-1.685l3.482-2.227a1 1 0 0 1 1.077 1.685z"></path>
						<path d="M18.903 12.41a1 1 0 0 1-1.826.815l-1.508-3.38a1 1 0 1 1 1.826-.815z"></path>
					</g>
				</svg>
				@LoadingSpinner("22")
			</button>
			<button
				hx-delete={ "/api/recipes/" + recipe.Id }
				hx-target={ "#recipe-" + recipe.Id }
				hx-swap="outerHTML"
				type="button"
				class="inline-flex items-center justify-center w-10 h-10 rounded-xl text-red hover:bg-red/15 active:scale-[0.95] transition-all hover:cursor-pointer"
			>
				<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" class="button-icon">
					<path fill="currentColor" d="M7 21q-.825 0-1.412-.587T5 19V6H4V4h5V3h6v1h5v2h-1v13q0 .825-.587 1.413T17 21zM17 6H7v13h10zM9 17h2V8H9zm4 0h2V8h-2zM7 6v13z"></path>
				</svg>
				@LoadingSpinner("22")
			</button>
		</div>
	}
}

// FavoriteRecipe is a recipe card on the favorites page. Its actions manage the
// favorite and whether it's on the homepage, rather than the homepage's list.
templ FavoriteRecipe(recipe services.Recipe) {
	@recipeCard(recipe, false) {
		<div class="flex items-center gap-1 shrink-0">
			@WeekToggle(recipe)
			@FavoriteButton(recipe.Favorite, recipe.Id)
		</div>
	}
}

// GroceryToggle sets whether a recipe counts toward the grocery list. The server
// renders the result, so the button always shows what was saved.
templ GroceryToggle(recipe services.Recipe) {
	<button
		hx-post={ "/api/recipes/groceries/" + recipe.Id }
		hx-swap="outerHTML"
		type="button"
		aria-pressed={ strconv.FormatBool(!recipe.SkipGroceries) }
		aria-label="On grocery list"
		class={ "inline-flex items-center justify-center w-10 h-10 rounded-xl active:scale-[0.95] transition-all hover:cursor-pointer",
			templ.KV("text-lavender bg-lavender/15 hover:bg-lavender/25", !recipe.SkipGroceries),
			templ.KV("grocery-off text-subtext0 hover:bg-surface1", recipe.SkipGroceries) }
	>
		<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" class="button-icon">
			<path fill="currentColor" d="M7 22q-.825 0-1.412-.587T5 20q0-.825.588-1.412T7 18q.825 0 1.413.588T9 20q0 .825-.587 1.413T7 22m10 0q-.825 0-1.412-.587T15 20q0-.825.588-1.412T17 18q.825 0 1.413.588T20 20q0 .825-.587 1.413T17 22M6.15 6l2.4 5h7l2.75-5zM5.2 4h14.75q.575 0 .875.513t.025 1.037l-3.55 6.4q-.275.5-.737.775T15.55 13H8.1L7 15h11q.425 0 .713.288T19 16q0 .425-.288.713T18 17H7q-1.125 0-1.7-.988t-.05-1.962L6.6 11.6L3 4H2q-.425 0-.712-.288T1 3q0-.425.288-.712T2 2h1.625q.275 0 .525.15t.375.425z"></path>
			if recipe.SkipGroceries {
				<path stroke="currentColor" stroke-width="2" stroke-linecap="round" d="M3 3l18 18"></path>
			}
		</svg>
		@LoadingSpinner("22")
	</button>
}

// WeekToggle adds a recipe to the homepage, or takes it back off.
templ WeekToggle(recipe services.Recipe) {
	<button
		hx-post={ "/api/recipes/week/" + recipe.Id }
		hx-swap="outerHTML"
		type="button"
		aria-pressed={ strconv.FormatBool(recipe.InWeek) }
		class={ "inline-flex items-center justify-center gap-1.5 h-10 px-3 rounded-xl text-sm font-semibold active:scale-[0.97] transition-all hover:cursor-pointer",
			templ.KV("bg-lavender text-crust hover:opacity-90", !recipe.InWeek),
			templ.KV("text-green bg-green/15 hover:bg-green/25", recipe.InWeek) }
	>
		<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" class="button-icon">
			if recipe.InWeek {
				<path fill="currentColor" d="m9.55 18l-5.7-5.7l1.425-1.425L9.55 15.15l9.175-9.175L20.15 7.4z"></path>
			} else {
				<path fill="currentColor" d="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6z"></path>
			}
		</svg>
		@LoadingSpinner("18")
		if recipe.InWeek {
			Added
		} else {
			Add to this week
		}
	</button>
}

templ recipeCard(recipe services.Recipe, oob bool) {
	<div
		id={ "recipe-" + recipe.Id }
		class="group/card bg-surface0 rounded-2xl p-4 border border-surface1 has-[.grocery-off]:bg-transparent has-[.grocery-off]:border-dashed"
		x-data="{ open: false }"
		if oob {
			hx-swap-oob="beforeend:#recipes"
		}
	>
		<button
			x-on:click="open = !open"
			class="w-full flex items-start justify-between gap-2 text-left hover:cursor-pointer"
		>
			<h2 class="min-w-0 text-text font-semibold text-lg leading-snug group-has-[.grocery-off]/card:text-subtext0">{ recipe.Name }</h2>
			<svg class="shrink-0 mt-0.5 text-subtext0 transition-transform duration-200" x-bind:class="{ 'rotate-180': open }" xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24">
				<path fill="currentColor" d="M16.59 8.59L12 13.17L7.41 8.59L6 10l6 6l6-6z"></path>
			</svg>
		</button>
		<div class="flex items-center justify-between gap-2 mt-1">
			<p class="min-w-0 text-subtext0 text-sm">
				{ recipe.Time }
				<span class="hidden group-has-[.grocery-off]/card:inline">· not on grocery list</span>
			</p>
			{ children... }
		</div>
		<div
			x-show="open"
			class="mt-3 pt-3 border-t border-surface1"
		>
			@MakeRecipe(recipe)
			<div class="mb-4">
				<h3 class="text-green text-sm font-semibold uppercase tracking-wide mb-2">Ingredients</h3>
				<ul class="grid sm:grid-cols-2 gap-x-4 gap-y-1.5">
					for _, ingredient := range recipe.Ingredients {
						<li class="text-text text-base flex items-start gap-2">
							<span class="text-green mt-1 shrink-0">•</span>
							{ services.FormatIngredient(ingredient) }
						</li>
					}
				</ul>
			</div>
			<div>
				<h3 class="text-blue text-sm font-semibold uppercase tracking-wide mb-2">Steps</h3>
				<ol class="space-y-2">
					for i, step := range recipe.Steps {
						<li class="text-text text-base flex gap-2.5">
							<span class="text-blue font-semibold shrink-0 w-6 text-right">{ strconv.Itoa(i+1) }.</span>
							<span>{ step }</span>
						</li>
					}
				</ol>
			</div>
		</div>
	</div>
}
