package views

// Index is the document around a page. Everything that changes after an action
// lives inside #page: requests from inside it re-render the page with the
// change applied (see handlers/pages.go), one request at a time, because each
// one reads and then rewrites the user's whole state document.
templ Index(page templ.Component) {
	<!DOCTYPE html>
	<html lang="en" class="mocha">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<meta name="htmx-config" content='{"historyCacheSize":0,"refreshOnHistoryMiss":true}'/>
			<link rel="preconnect" href="https://fonts.googleapis.com"/>
			<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
			<link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&display=swap" rel="stylesheet"/>
			<link rel="stylesheet" href={ Asset("/dist/tailwind.css") }/>
			<link rel="icon" href={ Asset("/dist/favicon.ico") }/>
			<script defer src={ Asset("/dist/app.js") }></script>
			<script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.15.12/dist/cdn.min.js"></script>
			<script src="https://cdn.jsdelivr.net/npm/htmx.org@2.0.10/dist/htmx.min.js"></script>
			<script>
				// The recipe whose cooking view is open, if any.
				let cookingId = null;

				// htmx restores a cached page on popstate when the entry underneath came
				// from an hx-push-url navigation, which would replace the recipe card when
				// the back button closes the view. This has to be added while the page is
				// parsing, because listeners on window run in the order they were added
				// and a card's own listener may be added long after htmx's.
				window.addEventListener('popstate', (e) => {
					const wanted = e.state?.cook ?? null;
					if (wanted === cookingId) return;
					e.stopImmediatePropagation();
					window.dispatchEvent(new CustomEvent('cook-history', { detail: wanted }));
				});

				document.addEventListener('alpine:init', () => {
					const COOK_PROGRESS_KEY = 'cookProgress';
					const COOK_PROGRESS_TTL = 3 * 24 * 60 * 60 * 1000;

					// Storage can be unavailable (e.g. private browsing); cooking still
					// works in that case, it just won't survive a refresh.
					function readCookProgress() {
						try {
							const all = JSON.parse(localStorage.getItem(COOK_PROGRESS_KEY)) || {};
							return Object.fromEntries(
								Object.entries(all).filter(([, p]) => Date.now() - p.at < COOK_PROGRESS_TTL)
							);
						} catch {
							return {};
						}
					}

					function writeCookProgress(all) {
						try {
							localStorage.setItem(COOK_PROGRESS_KEY, JSON.stringify(all));
						} catch {}
					}

					const GROCERY_CHECKED_KEY = 'groceryChecked';

					Alpine.data('groceryList', () => ({
						doubled: false,
						checked: (() => {
							try {
								return JSON.parse(localStorage.getItem(GROCERY_CHECKED_KEY)) || [];
							} catch {
								return [];
							}
						})(),
						isChecked(key) {
							return this.checked.includes(key);
						},
						toggle(key) {
							this.checked = this.isChecked(key)
								? this.checked.filter((k) => k !== key)
								: [...this.checked, key];
							this.save();
						},
						clear() {
							this.checked = [];
							this.save();
						},
						save() {
							try {
								localStorage.setItem(GROCERY_CHECKED_KEY, JSON.stringify(this.checked));
							} catch {}
						},
					}));

					Alpine.data('cookMode', (id, total) => {
						let wakeLock = null;
						// The word the ingredient tip points at. It stays out of Alpine's
						// reactive state, which can't wrap a DOM element.
						let tipFor = null;
						return {
							cooking: false,
							// The ingredient line shown for a word tapped in a step, or null.
							tip: null,
							// 0 is the ingredient list; 1..total are the recipe's steps.
							step: 0,
							checked: [],
							peek: false,
							get progress() {
								return total ? (this.step / total) * 100 : 0;
							},
							get nextLabel() {
								if (this.peek) return `Back to step ${this.step}`;
								if (this.step === total) return 'Done';
								return this.step === 0 ? 'Start cooking' : 'Next';
							},
							init() {
								const saved = readCookProgress()[id];
								if (saved) {
									this.step = Math.min(saved.step, total);
									this.checked = saved.checked;
								}
								this.$watch('step', () => this.save());
								this.$watch('checked', () => this.save());
								this.$watch('step', () => this.hideTip());
								this.$watch('peek', () => this.hideTip());
								// The browser keeps history state across a refresh, so this
								// reopens the view if it was open when the page reloaded.
								if (history.state?.cook === id) this.show();
							},
							save() {
								const all = readCookProgress();
								if (this.step === 0 && this.checked.length === 0) {
									delete all[id];
								} else {
									all[id] = { step: this.step, checked: this.checked, at: Date.now() };
								}
								writeCookProgress(all);
							},
							// Opening adds a history entry so the phone's back button closes
							// the view instead of leaving the page.
							start() {
								history.pushState({ cook: id }, '');
								this.show();
							},
							show() {
								// The view sits inside the recipe card's collapsible section,
								// which starts collapsed after a refresh.
								this.open = true;
								this.cooking = true;
								cookingId = id;
								document.body.classList.add('overflow-hidden');
								this.keepAwake();
								this.$nextTick(() => this.$refs.next.focus());
							},
							hide() {
								this.hideTip();
								this.cooking = false;
								cookingId = null;
								this.peek = false;
								document.body.classList.remove('overflow-hidden');
								wakeLock?.release();
								wakeLock = null;
								this.$refs.opener.focus();
							},
							// Closing goes back through history, and syncHistory does the hiding.
							close() {
								if (history.length > 1) {
									history.back();
								} else {
									history.replaceState(null, '');
									this.hide();
								}
							},
							syncHistory(wanted) {
								if (wanted === id) {
									this.show();
								} else if (this.cooking) {
									this.hide();
								}
							},
							finish() {
								this.step = 0;
								this.checked = [];
								this.close();
							},
							goTo(step) {
								this.step = step;
								this.$refs.body.scrollTop = 0;
							},
							next() {
								if (this.peek) {
									this.peek = false;
								} else if (this.step === total) {
									this.finish();
								} else {
									this.goTo(this.step + 1);
								}
							},
							back() {
								this.goTo(this.step - 1);
							},
							// A mouse shows an ingredient's amount on hover; a tap or a key
							// press shows it until the next tap.
							hoverTip(e) {
								if (e.pointerType === 'mouse') this.showTip(e.currentTarget);
							},
							leaveTip(e) {
								if (e.pointerType === 'mouse') this.hideTip();
							},
							toggleTip(e) {
								const el = e.currentTarget;
								if (tipFor === el && e.pointerType !== 'mouse') {
									this.hideTip();
								} else {
									this.showTip(el);
								}
							},
							showTip(el) {
								tipFor = el;
								this.tip = el.dataset.amount;
								this.$nextTick(() => this.placeTip());
							},
							hideTip() {
								tipFor = null;
								this.tip = null;
							},
							// Sits above the word, or below it near the top, and stays on screen.
							placeTip() {
								const tip = this.$refs.tip;
								if (!tipFor || !tip) return;
								const word = tipFor.getBoundingClientRect();
								const gap = 16;
								const left = word.left + word.width / 2 - tip.offsetWidth / 2;
								tip.style.left = `${Math.max(gap, Math.min(left, innerWidth - tip.offsetWidth - gap))}px`;
								const above = word.top - tip.offsetHeight - 8;
								tip.style.top = `${above < gap ? word.bottom + 8 : above}px`;
							},
							handleKey(e) {
								if (!this.cooking) return;
								if (e.key === 'Escape' && this.tip) {
									this.hideTip();
								} else if (e.key === 'Escape') {
									this.peek ? (this.peek = false) : this.close();
								} else if (this.peek) {
									return;
								} else if (e.key === 'ArrowRight' && this.step < total) {
									this.next();
								} else if (e.key === 'ArrowLeft' && this.step > 0) {
									this.back();
								}
							},
							// The browser drops the lock whenever the page is hidden, so this
							// also runs when the page becomes visible again.
							async keepAwake() {
								if (!this.cooking || document.visibilityState !== 'visible' || !navigator.wakeLock) return;
								try {
									const lock = await navigator.wakeLock.request('screen');
									if (this.cooking) {
										wakeLock = lock;
									} else {
										lock.release();
									}
								} catch {
									// Not fatal: the screen just follows its normal timeout.
								}
							},
						};
					});
				});
			</script>
			<title>Magenta Carrot</title>
		</head>
		<body
			class="bg-base text-text pb-16 md:pb-0"
			hx-target="#page"
			hx-swap="innerHTML"
			hx-include="#view-ctx"
			hx-sync="#page:queue all"
		>
			<div id="page">
				@page
			</div>
			<div id="drawer"></div>
		</body>
	</html>
}
